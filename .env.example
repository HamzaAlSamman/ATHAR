# ===== إعدادات موقع أثر (انسخ هذا الملف إلى .env.local للتطوير، وأضف القيم نفسها في Vercel للإنتاج) =====

# ---------- مطلوب قبل النشر للعامة ----------

# الرابط الرسمي للموقع (يستخدم في الـ SEO والـ sitemap وروابط المشاركة)
NEXT_PUBLIC_SITE_URL=https://athr.agency

# رقم واتساب بصيغة دولية بدون + أو مسافات (مثال: 966512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# البريد الذي تصله الطلبات ويظهر في صفحتي الخصوصية والشروط
CONTACT_EMAIL=

# كلمة مرور لوحة التحكم /admin (طويلة وعشوائية؛ بدونها اللوحة معطّلة)
ADMIN_PASSWORD=

# ---------- مطلوب على Vercel (serverless) ----------

# مخزن مشترك للطلبات وحد الطلبات وتخزين التقارير مؤقتاً.
# أضف تكامل Upstash Redis من Vercel Marketplace فتُضبط هذه القيم تلقائياً.
# بدونها: تُحفظ الطلبات في data/leads.json (يعمل محلياً فقط، ويضيع على Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# إشعار بريد بكل طلب عبر Resend (https://resend.com). بدونه: الطلب يُحفظ في المخزن فقط.
RESEND_API_KEY=
# المرسِل من نطاق موثّق في Resend
RESEND_FROM=Athar <onboarding@resend.dev>

# ---------- اختياري ----------

# روابط التواصل الاجتماعي (تُخفى الأيقونة إن تُركت فارغة)
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# بيانات قانونية حقيقية: قسم "الموثوقية" يظهر فقط إن ضُبط رقم السجل
NEXT_PUBLIC_CR_NUMBER=
NEXT_PUBLIC_MAAROOF_URL=

# يرقّي قياس السرعة في الفحص إلى تقييم Lighthouse الكامل (مجاني من Google Cloud: PageSpeed Insights API)
PAGESPEED_API_KEY=

# مساعد أثر الذكي (بدونه يرد برسالة توجّه للفحص والتواصل)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# سر توقيع جلسات لوحة التحكم (اختياري؛ الافتراضي مشتق من ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
