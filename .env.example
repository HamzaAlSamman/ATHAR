# ===== إعدادات موقع أثر (انسخ هذا الملف إلى .env.local واملأ القيم) =====

# الرابط الرسمي للموقع (يستخدم في الـ SEO والـ sitemap)
NEXT_PUBLIC_SITE_URL=https://athr.agency

# بيانات التواصل
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000
CONTACT_EMAIL=hello@athr.agency

# روابط التواصل الاجتماعي (اختيارية)
NEXT_PUBLIC_SOCIAL_X=https://x.com/
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/

# إرسال بريد نموذج التواصل عبر Resend (اختياري — بدونه تُسجّل الطلبات محلياً فقط)
# احصل على المفتاح من https://resend.com
RESEND_API_KEY=
# المُرسِل المعتمد لدى Resend (نطاق موثّق)
RESEND_FROM=Athar <onboarding@resend.dev>

# المختبر التقني يجري فحص أداء حقيقياً بدون أي مفتاح (TTFB، الحجم، الضغط، SEO، الأمان).
# هذا المفتاح اختياري فقط لترقية النتيجة إلى تقرير Lighthouse كامل عبر Google PageSpeed Insights.
# احصل عليه من https://console.cloud.google.com/ (PageSpeed Insights API)
PAGESPEED_API_KEY=

# مساعد أثر الذكي عبر Claude (اختياري — بدونه يعمل برسائل افتراضية)
# احصل على المفتاح من https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# كلمة مرور لوحة التحكم البسيطة /admin
ADMIN_PASSWORD=change-me
